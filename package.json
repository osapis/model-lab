{
  "name": "model-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"node --env-file-if-exists=.env --import tsx --watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:cloudflare": "tsc --noEmit -p cloudflare/tsconfig.json",
    "build:cloudflare": "wrangler deploy --config cloudflare/wrangler.jsonc --dry-run",
    "deploy:cloudflare": "python3 cloudflare/tools/deploy.py",
    "test:cloudflare": "node tools/local-cloudflare-smoke.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "cron-parser": "5.10.1",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.20.0",
    "undici": "7.29.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260915.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "miniflare": "5.20260911.1-alpha",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wrangler": "^4.131.2"
  },
  "license": "MIT",
  "description": "A self-hosted API model testing lab with visual results, scheduling, and encrypted configuration backups.",
  "repository": {
    "type": "git",
    "url": "https://github.com/jinshenganyuci/model-lab.git"
  }
}
