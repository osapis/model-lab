# 复制为 .env 后设置权限 chmod 600 .env，切勿提交真实配置。
# Docker Compose 默认从当前源码构建 model-lab:local。
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
DATA_DIR=.data
# Docker 默认仅监听服务器本机，适合通过 HTTPS 反向代理提供访问。
# 局域网直连时可改为服务器的局域网 IP，或 0.0.0.0。
BIND_ADDRESS=127.0.0.1

# 默认使用后台“全局设置”的请求超时（600 秒）。仅 Node/Docker 需要强制覆盖时启用：
# REQUEST_TIMEOUT_MS=600000

# 留空使用首次启动生成的 .data/admin-token；如需覆盖，填写强随机口令。
ADMIN_TOKEN=

# 反向代理 / 自定义域名时填写实际来源，不带路径，例如 https://lab.example.com。
# 本机直接访问无需填写；HTTPS 部署同时设置 COOKIE_SECURE=true。
APP_ORIGIN=
COOKIE_SECURE=false

# API 与 R2/S3 凭证在后台配置，切勿把真实密钥提交到仓库。
# Compose 中 HOST 固定为 0.0.0.0、DATA_DIR 固定为 /app/.data，PORT 为宿主机端口。
